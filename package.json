{
	"name": "obsidian-png-metadata-editor",
	"version": "0.1.0",
	"description": "Obsidian plugin to view and edit PNG metadata, with a SillyTavern character card mode",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "tsc -p test --noEmit && mocha && python3 scripts/validate-output.py",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts"
	},
	"keywords": [
		"obsidian",
		"png",
		"metadata",
		"sillytavern"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.17",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"mocha": "^10.8.2",
		"obsidian": "latest",
		"obsidian-launcher": "^3.3.0",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"wdio-obsidian-reporter": "^3.3.0",
		"wdio-obsidian-service": "^3.3.0"
	},
	"dependencies": {
		"fflate": "^0.8.3"
	}
}
